#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>      // ADDED: Bluetooth profile controls
#include <dt-bindings/zmk/outputs.h> // ADDED: Physical connection toggle

/ {
    behaviors {
        encoder_btn: hold_tap_encoder {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>; 
            bindings = <&tog>, <&kp>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        volume_layer {
            display-name = "YT Music";
            bindings = <
                &kp C_PREV  &kp C_MUTE  &kp C_NEXT  &encoder_btn 1 C_PP
            >;
            sensor-bindings = <&inc_dec_kp LC(LS(F12)) LC(LS(F11))>;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp F1      &kp F2      &studio_unlock  &encoder_btn 2 C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };        

        misc_layer {
            display-name = "Misc";
            bindings = <
                &bt BT_CLR  &bt BT_NXT  &studio_unlock   &to 0
            >;
        
        };



        
    };
};
