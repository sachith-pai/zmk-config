#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        /* 
         * Define your custom macros here. 
         * Because ZMK Studio is active, it will auto-detect these 
         * behaviors and list them under the "Macros" or "User Behaviors" tab.
         */
        zmk_studio_macro: zmk_studio_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Z &kp M &kp K &kp SPACE &kp S &kp T &kp U &kp D &kp I &kp O>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /*
             * Replace these placeholders with your actual matrix layout positions.
             * This configuration includes the unlock key and your macro.
             */
            bindings = <
                &kp ESC          &kp Q             &kp W             &kp E
                &kp LSHIFT       &kp A             &kp S             &zmk_studio_macro
                &kp LCTRL        &kp Z             &kp X             &studio_unlock
            >;
        };
    };
};