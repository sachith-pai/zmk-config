#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Bindings for the 3 buttons
            bindings = <
                &kp A      &kp B      &kp C 
            >;

            // Bindings for the EC11 Encoder (Clockwise / Counter-Clockwise)
            // Example: Volume Up and Volume Down
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};