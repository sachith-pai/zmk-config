/ {
    chosen {
        zmk,kscan = &kscan0;
        zephyr,display = &oled;
    };

    // 1. Define the 3 Buttons via Direct GPIO (No matrix needed)
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // D0
            , <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // D1
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // D2
            ;
    };

    // 2. Define the EC11 Encoder
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // D7
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // D8
        steps = <80>;
        status = "okay";
    };

    // 3. Register the Encoder as a ZMK Sensor
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};

// 4. Define the OLED on the I2C0 Bus
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    
    // XIAO BLE specific I2C pins for D4 and D5
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>; // Change to 64 if you have a 128x64 display
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>; // Change to 63 if you have a 128x64 display
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};